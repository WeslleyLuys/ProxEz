# Copie para .env e preencha com valores reais. NUNCA faça commit do .env.

# Identidade do proxy
PROXY_IP=192.0.2.10                 # IP público deste proxy
PROXY_NET=192.0.2                   # prefixo de rede pública (sem o último octeto)
DOMAIN=pabx.example.com            # FQDN do PABX (usado no TLS/SNI)

# Rede interna dos containers Asterisk
CONTAINER_IP=10.0.0.0              # faixa interna dos containers
INTERNAL_NET=10                    # prefixo interno usado em matches de rede

# API de provisionamento (resolve ramal -> container, faz balanceamento)
API_HOST=10.0.0.50
API_PORT=8888

# TLS (Let's Encrypt ou outro)
TLS_PRIVATE_KEY=/etc/letsencrypt/live/pabx.example.com/privkey.pem
TLS_CERT=/etc/letsencrypt/live/pabx.example.com/fullchain.pem

# SIP
SIP_REALM=example

# Painel admin (Flask)
SECRET_KEY=GERE-UMA-STRING-LONGA-ALEATORIA-AQUI

# Acesso SSH aos hosts/containers (use um secret manager em produção)
SSH_PORT=22
SSH_PASSWORD=
